new file mode 100644
index 0000000..79499e6
--- /dev/null
+++ b/apps/frontend/src/components/bobba/BobbaLinksView.tsx
@@ -0,0 +1,35 @@
+// Bobba Hotel's own links ("bobba/..."), used by our buttons and by messages from the game server:
+//   bobba/getroom        ask the server for your first room (the lobby bot)
+//   bobba/delete/<id>    staff: delete a furni for good (not into anyone's inventory)
+// They reach our game server plugin as hidden chat commands.
+import {ILinkEventTracker, RoomUnitChatComposer} from "@nitro/renderer";
+import {FC, useEffect} from "react";
+
+import {AddEventLinkTracker, RemoveLinkEventTracker, SendMessageComposer} from "../../api";
+
+export const BobbaLinksView: FC<{}> = () => {
+  useEffect(() => {
+    const tracker: ILinkEventTracker = {
+      linkReceived: (url: string) => {
+        const parts = url.split("/");
+        switch (parts[1]) {
+          case "getroom":
+            SendMessageComposer(new RoomUnitChatComposer(":getroom"));
+            return;
+          case "delete": {
+            const id = parseInt(parts[2]);
+            if (id > 0) SendMessageComposer(new RoomUnitChatComposer(`:deletefurni ${id}`));
+            return;
+          }
+        }
+      },
+      eventUrlPrefix: "bobba/",
+    };
+
+    AddEventLinkTracker(tracker);
+
+    return () => RemoveLinkEventTracker(tracker);
+  }, []);
+
+  return null;
+};
